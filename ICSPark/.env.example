# Copia a .env antes de levantar (docker compose usa .env automáticamente)

# Flag final (revelada por el visualizador al abrir la puerta del T-Rex)
FINAL_FLAG=ICSPARK{cl3v3r_g1rl_th3_r3x_1s_l00se}

# Credenciales del auditor (públicas / se entregan al jugador para entrar al portal)
AUDITOR_USER=auditor
AUDITOR_PASS=inGen2025

# Host/puerto interno del SCADA (red-ot). No cambiar salvo que edites el compose.
SCADA_HOST=scada
SCADA_PORT=5000

# Host/puerto del PLC de proceso (red-plc)
PLC_HOST=plc
PLC_PORT=502

# Host/puerto del controlador de seguridad SIS-09 (red-plc)
SAFETY_HOST=safety
SAFETY_PORT=502
